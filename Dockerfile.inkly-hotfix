# syntax=docker/dockerfile:1

# Publish application-only Inkly fixes without rebuilding CWA's system and
# Python dependencies. The base tag is resolved before the replacement image
# is pushed, so it refers to the last complete Inkly image.
ARG BASE_IMAGE=ghcr.io/golitedev/calibre-web-automated:inkly-latest
FROM ${BASE_IMAGE}

ARG VERSION

COPY --chown=abc:abc cps/ /app/calibre-web-automated/cps/
COPY --chown=abc:abc koreader/plugins/cwasync.koplugin/ /app/calibre-web-automated/koreader/plugins/cwasync.koplugin/

# Keep the downloadable plugin paired with the updated server modules/templates.
RUN cd /app/calibre-web-automated/koreader/plugins && \
    rm -f /app/calibre-web-automated/cps/static/koplugin.zip && \
    zip -qr /app/calibre-web-automated/cps/static/koplugin.zip cwasync.koplugin && \
    echo "${VERSION}" > /app/CWA_RELEASE
